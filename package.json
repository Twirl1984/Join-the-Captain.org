{
  "name": "join-the-captain-org",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community- & Medien-Standbein der Segel-Plattform Join the Captain",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:erlebnis": "tsx scripts/seed-erlebnis-poi.ts",
    "pipeline:run": "tsx scripts/run-pipeline.ts",
    "research:run": "tsx scripts/run-research.ts",
    "erlebnis:kuration": "tsx scripts/erlebnis-kuration.ts",
    "discovery:run": "tsx scripts/run-discovery.ts",
    "test:weather": "node --import tsx --test src/lib/weather/__tests__/*.test.ts",
    "test:navigation": "node --import tsx --test src/lib/navigation/__tests__/*.test.ts",
    "test:erlebnis": "node --import tsx --test src/lib/erlebnis/__tests__/*.test.ts",
    "test:toern": "node --import tsx --test src/lib/toern/__tests__/*.test.ts",
    "test:i18n": "node --import tsx --test src/lib/i18n/__tests__/*.test.ts",
    "test:marketing": "node --import tsx --test src/lib/marketing/__tests__/*.test.ts",
    "test:analytics": "node --import tsx --test src/lib/analytics/__tests__/*.test.ts",
    "nav:watermask": "tsx scripts/navigation-fetch-watermask.ts",
    "test:e2e": "playwright test",
    "weather:backtest": "tsx scripts/weather-backtest-fetch.ts && tsx scripts/weather-backtest-run.ts",
    "weather:verify": "tsx scripts/weather-feedback-verify.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:lib && npm run test:weather && npm run test:navigation && npm run test:erlebnis && npm run test:toern && npm run test:i18n && npm run test:marketing && npm run test:analytics && npm run trace",
    "test:lib": "node --import tsx --test src/lib/__tests__/*.test.ts",
    "nav:icons": "tsx scripts/generate-app-icons.ts",
    "trace": "tsx scripts/trace-check.ts",
    "test:mutation": "node --import tsx --test src/lib/navigation/__tests__/peilung.test.ts src/lib/navigation/__tests__/route-profiles.test.ts src/lib/navigation/__tests__/depth.test.ts",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "leaflet": "^1.9.4",
    "next": "15.5.19",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@geo-maps/earth-coastlines-1km": "^0.6.0",
    "@geo-maps/earth-lakes-1km": "^0.6.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}

# ── Datenbank (Supabase / PostgreSQL) ───────────────────────────────
# Pooler-URL für die App, Direct-URL für Migrationen.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jtc_org

# ── Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelle sind im Code fixiert (Haiku für Struktur/Scout/Moderation,
# Sonnet fürs Sizing), können hier aber überschrieben werden.
MODEL_HAIKU=claude-haiku-4-5-20251001
MODEL_SONNET=claude-sonnet-4-6
# SDK-Timeouts (gegen Hänger/Kosten):
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MAX_RETRIES=2

# ── Research-Scout (nächtlich, web-gestützt) ────────────────────────
# Braucht ANTHROPIC_API_KEY (web_search). Ohne Key wird der Scan still
# übersprungen. Defaults sind bewusst sparsam, damit ein Nacht-Lauf das
# Guthaben nicht leersaugt. Web-Suche kostet ~$0,01 pro Suche + Token.
RESEARCH_MAX_ITEMS=6           # Themen pro Queue & Lauf
RESEARCH_WEB_MAX_USES=3        # Web-Suchen pro Thema (harte Obergrenze/Anfrage)
RESEARCH_MIN_CONFIDENCE=0.5    # ab hier Auto-Publish (0..1)
RESEARCH_MELDE_SCHWELLE=3      # Meldungen bis Depublizieren + Neu-Recherche
RESEARCH_REPORT_DIR=./reports  # Ablage der Lauf-Reports
# Globale Bremsen für den GESAMTEN Lauf (greifen über beide Queues):
RESEARCH_MAX_SEARCHES=20       # max. Web-Suchen pro Lauf (Kostendeckel, ~$0,20)
RESEARCH_TIME_BUDGET_MS=240000 # Zeitbudget pro Lauf (4 min), dann Abbruch
RESEARCH_CALL_TIMEOUT_MS=90000 # Timeout pro einzelner Such-Anfrage
# Teil B: Kostenlose Alternativen + Teil D: Jährliche Neubewertung
RESEARCH_REEVAL_TAGE=365       # Tage bis Neubewertung (default 1 Jahr). Tools älter als X Tage werden erneut recherchiert.

# ── Stripe (Connect, Pledges) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Discord (Stub) ──────────────────────────────────────────────────
DISCORD_WEBHOOK_SECRET=

# ── Plausible (DSGVO-Analytics) ─────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=join-the-captain.org
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ── Auth-Stub ───────────────────────────────────────────────────────
# Einfacher Session-Stub bis echtes Auth steht. Nicht für Produktion.
SESSION_SECRET=dev-only-change-me

# ── Discovery-Agent (YouTube, Feature-geflaggt) ───────────────────
# YouTube-Discovery-Agent: nur wenn ENABLED=true UND YOUTUBE_API_KEY gesetzt.
# Standard: deaktiviert (kein Key). Kostendeckel pro Lauf + Tag (EUR).
YOUTUBE_DISCOVERY_ENABLED=false
YOUTUBE_API_KEY=                 # Leer = deaktiviert (Feature-geflaggt)
DISCOVERY_MAX_RUN_BUDGET_EUR=0.25    # Hard cap pro Lauf (Haiku nur)
DISCOVERY_MAX_DAILY_BUDGET_EUR=0.25  # Hard cap täglich (informativ)
DISCOVERY_MAX_CANDIDATES=3        # Max. Videos pro Thema
DISCOVERY_MIN_RELEVANCE=0.6       # Min. Relevance-Score (0..1)

# ── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Feature-Flags (Kill-Switch / Rollback, Default an — "off" deaktiviert)
# NEXT_PUBLIC_* wird zur Build-Zeit eingebacken: Rollback = Env setzen + Rebuild.
NEXT_PUBLIC_FEATURE_NAVIGATION=
